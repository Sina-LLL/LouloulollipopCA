      "type": "collapsible-tabs",
      "blocks": {
        "question_NrBYQb": {
          "type": "question",
          "settings": {
            "title": "Will it be stroller accessible?",
            "answer": "<p>Yes - We will have Stroller parking right outside of our warehouse [right side of the door]</p>"
          }
        },
        "question_XGUpzW": {
          "type": "question",
          "disabled": true,
          "settings": {
            "title": "Will you restock daily?",
            "answer": "<p>Yes! We’ll be restocking inventory daily, so there will be new finds every day. </p>"
          }
        },
        "question_B979fM": {
          "type": "question",
          "settings": {
            "title": "Will there be changing rooms and a breastfeeding area?",
            "answer": "<p>Yes, there will be changing rooms and a private breastfeeding area for your convenience.</p>"
          }
        },
        "question_pWXzLJ": {
          "type": "question",
          "settings": {
            "title": "Do I need to physically line up outside the warehouse?",
            "answer": "<p>No, there will be no in-person lineup. Instead, you can book a time to enjoy our Black Friday deals in person.</p>"
          }
        },
        "question_rU7gdm": {
          "type": "question",
          "disabled": true,
          "settings": {
            "title": "Can I join the virtual line from anywhere?",
            "answer": "<p>No, you can only join the virtual lineup if you are within 250 meters of the warehouse location. This ensures that only those close by are in the queue for entry.</p>"
          }
        },
        "question_YJH7nf": {
          "type": "question",
          "disabled": true,
          "settings": {
            "title": "Can I leave the area once I join the virtual lineup?",
            "answer": "<p>Once you've joined the virtual lineup, you can leave the immediate area, but you must remain within 250 meters of the warehouse in order to maintain your place in the queue.</p>"
          }
        }
      },
