<div id="section-id-{{ section.id }}" class="hcr-section" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.2s"' -%}>
  {% style %}
    /* Full-bleed track — no clipping wrapper needed */
    #section-id-{{ section.id }} .hcr-inner {
      position: relative;
    }

    #section-id-{{ section.id }} .hcr-track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 12px;
      {% if section.blocks.size > 1 %}
        padding: 0 {{ section.settings.peek_size_mobile }}px;
      {% else %}
        justify-content: center;
      {% endif %}
    }
    @media (min-width: 768px) {
      #section-id-{{ section.id }} .hcr-track {
        gap: 16px;
        {% if section.blocks.size > 1 %}
          padding: 0 {{ section.settings.peek_size }}px;
        {% endif %}
      }
    }
    #section-id-{{ section.id }} .hcr-track::-webkit-scrollbar {
      display: none;
    }

    #section-id-{{ section.id }} .hcr-slide {
      {% if section.blocks.size > 1 %}
        flex: 0 0 calc(100% - {{ section.settings.peek_size_mobile }}px * 2 - 12px);
      {% else %}
        flex: 0 0 100%;
      {% endif %}
      min-width: 0;
      scroll-snap-align: center;
      position: relative;
      overflow: visible;
    }
    @media (min-width: 768px) {
      #section-id-{{ section.id }} .hcr-slide {
        {% if section.blocks.size > 1 %}
          flex: 0 0 calc(100% - {{ section.settings.peek_size }}px * 2 - 16px);
        {% endif %}
      }
    }

    {%- if section.settings.height == 'fixed' -%}
    #section-id-{{ section.id }} .hcr-slide {
      height: {{ section.settings.height_mobile }}px;
    }
    @media (min-width: 768px) {
      #section-id-{{ section.id }} .hcr-slide {
        height: {{ section.settings.height_desktop }}px;
      }
    }
    {%- else -%}
    #section-id-{{ section.id }} .hcr-slide {
      aspect-ratio: 1 / 1;
    }
    @media (min-width: 768px) {
      #section-id-{{ section.id }} .hcr-slide {
        aspect-ratio: 16 / 7;
      }
    }
    {%- endif -%}

    /* Border radius lives on the image and overlay, not the container */
    #section-id-{{ section.id }} .hcr-slide__image,
    #section-id-{{ section.id }} .hcr-slide .image-overlay__over,
    #section-id-{{ section.id }} .hcr-slide .placeholder-image {
      border-radius: {{ section.settings.border_radius }}px;
      overflow: hidden;
    }

    #section-id-{{ section.id }} .hcr-slide__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Dim non-active slides slightly to draw focus */
    #section-id-{{ section.id }} .hcr-slide__image,
    #section-id-{{ section.id }} .hcr-slide .placeholder-image {
      transition: opacity 0.3s ease, transform 0.3s ease;
      opacity: 0.6;
      transform: scale(0.97);
    }
    #section-id-{{ section.id }} .hcr-slide.is-active .hcr-slide__image,
    #section-id-{{ section.id }} .hcr-slide.is-active .placeholder-image {
      opacity: 1;
      transform: scale(1);
    }

    {%- for block in section.blocks -%}
    #section-id-{{ section.id }} .hcr-slide-{{ forloop.index }} .text-overlay__title {
      font-size: {{ block.settings.title_size_mobile }}px;
      {%- if block.settings.title_size_mobile >= 90 %}line-height: 1em;{%- endif %}
    }
    {%- endfor -%}
    @media (min-width: 768px) {
      {%- for block in section.blocks -%}
      {%- assign title_mid = block.settings.title_size | times: 0.7 | at_least: block.settings.title_size_mobile -%}
      #section-id-{{ section.id }} .hcr-slide-{{ forloop.index }} .text-overlay__title {
        font-size: {{ title_mid }}px;
        {%- if title_mid >= 90 %}line-height: 1em;{%- endif %}
      }
      {%- endfor -%}
    }
    @media (min-width: 1100px) {
      {%- for block in section.blocks -%}
      #section-id-{{ section.id }} .hcr-slide-{{ forloop.index }} .text-overlay__title {
        font-size: {{ block.settings.title_size }}px;
        {%- if block.settings.title_size >= 90 %}line-height: 1em;{%- endif %}
      }
      {%- endfor -%}
    }

    /* Arrows */
    #section-id-{{ section.id }} .hcr-arrows {
      pointer-events: none;
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 2;
    }
    #section-id-{{ section.id }} .hcr-arrow {
      pointer-events: auto;
      display: none;
      background: transparent;
      border: none;
      cursor: pointer;
      color: rgb(var(--image-overlay-text-color));
      padding: 7px;
    }
    @media (min-width: 768px) {
      #section-id-{{ section.id }} .hcr-arrow {
        display: block;
      }
    }
    #section-id-{{ section.id }} .hcr-arrow svg {
      display: block;
      width: 60px;
      height: 60px;
      stroke-width: 0.6;
      stroke: currentColor;
      fill: transparent;
      opacity: 0.8;
      filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));
    }
    #section-id-{{ section.id }} .hcr-arrow:hover svg {
      opacity: 1;
    }
    #section-id-{{ section.id }} .hcr-arrow[disabled] {
      opacity: 0;
      pointer-events: none;
    }

    /* Dots */
    #section-id-{{ section.id }} .hcr-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
      padding: 10px 0 0;
    }
    #section-id-{{ section.id }} .hcr-dot {
      display: block;
      padding: 4px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: rgb(var(--body-text-color));
    }
    #section-id-{{ section.id }} .hcr-dot svg {
      display: block;
      width: 20px;
      height: 20px;
    }
    #section-id-{{ section.id }} .hcr-dot .hcr-dot__bg {
      transition: stroke 0.2s, fill 0.2s, opacity 0.2s;
      stroke-width: 1px;
      stroke: currentColor;
      fill: transparent;
      opacity: 0.4;
    }
    #section-id-{{ section.id }} .hcr-dot.is-active .hcr-dot__bg {
      fill: currentColor;
      opacity: 1;
    }
  {% endstyle %}

  <div class="container">
    <div class="hcr-inner">

      <div class="hcr-track-wrapper">
        <div class="hcr-track" id="hcr-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign show_text = false
              if block.settings.title != blank or block.settings.subheading != blank or block.settings.text != blank or block.settings.button_label_1 != blank or block.settings.button_label_2 != blank
                assign show_text = true
              endif
              assign v_pos = block.settings.text_alignment | split: ' ' | first
              assign h_pos = block.settings.text_alignment | split: ' ' | last
            -%}
            <div class="hcr-slide hcr-slide-{{ forloop.index }} image-overlay image-overlay--bg-{{ section.settings.overlay_style }}" {{ block.shopify_attributes }}>

              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign loading = 'lazy'
                  assign fetchpriority = nil
                  if forloop.first
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  endif
                -%}
                {%- render 'image-desktop-and-mobile',
                  class: 'hcr-slide__image',
                  desktop_image: block.settings.image,
                  mobile_image: block.settings.mobile_image,
                  loading: loading,
                  fetchpriority: fetchpriority,
                  block: block
                -%}
              {%- else -%}
                <div class="hcr-slide__image placeholder-image dark">
                  {%- capture current %}{% cycle 1, 2 %}{% endcapture -%}
                  {{- 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' -}}
                </div>
              {%- endif -%}

              {%- if show_text -%}
                <div class="text-overlay text-overlay--for-banner text-overlay--v-{{ v_pos }} text-overlay--h-{{ h_pos }} image-overlay__over">
                  <div class="text-overlay__inner" style="--heading-max-width: {{ block.settings.heading_max_width }}em">
                    <div class="text-overlay__text">
                      {%- if block.settings.subheading != blank -%}
                        <div class="text-overlay__subheading subheading subheading--over">{{ block.settings.subheading | escape }}</div>
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                        {%- if block.settings.use_h1 -%}
                          <h1 class="text-overlay__title">{% render 'multiline-text' with block.settings.title %}</h1>
                        {%- else -%}
                          <h2 class="text-overlay__title h1">{% render 'multiline-text' with block.settings.title %}</h2>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <div class="text-overlay__rte rte {% if block.settings.enlarge_text %}large-text{% endif %}">{{ block.settings.text }}</div>
                      {%- endif -%}
                      {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                        <div class="text-overlay__button-row">
                          {%- if block.settings.button_label_1 != blank -%}
                            <a class="text-overlay__button btn btn--primary" href="{{ block.settings.button_url_1 }}{% if block.settings.button_tag_1 != blank %}/{{ block.settings.button_tag_1 | handle }}{% endif %}">{{ block.settings.button_label_1 | escape }}</a>
                          {%- endif -%}
                          {%- if block.settings.button_label_2 != blank -%}
                            <a class="text-overlay__button btn btn--secondary" href="{{ block.settings.button_url_2 }}{% if block.settings.button_tag_2 != blank %}/{{ block.settings.button_tag_2 | handle }}{% endif %}">{{ block.settings.button_label_2 | escape }}</a>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- elsif block.settings.slide_link != blank -%}
                <a class="image-overlay__image-link" href="{{ block.settings.slide_link }}" aria-label="{{ block.settings.title | default: 'Slide' | escape }}"></a>
              {%- endif -%}

            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="hcr-arrows js-only">
          <button class="hcr-arrow hcr-arrow--prev has-ltr-icon" id="hcr-prev-{{ section.id }}" aria-label="{{ 'general.slider.previous' | t }}" disabled>
            {% render 'icon-chevron-left' %}
          </button>
          <button class="hcr-arrow hcr-arrow--next has-ltr-icon" id="hcr-next-{{ section.id }}" aria-label="{{ 'general.slider.next' | t }}">
            {% render 'icon-chevron-right' %}
          </button>
        </div>
      {%- endif -%}

    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="hcr-dots js-only" id="hcr-dots-{{ section.id }}" role="tablist">
        {%- for block in section.blocks -%}
          <button class="hcr-dot{% if forloop.first %} is-active{% endif %}" role="tab" data-index="{{ forloop.index0 }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle class="hcr-dot__bg" cx="12" cy="12" r="6" />
            </svg>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  {%- if section.blocks.size > 1 -%}
  <script>
    (function() {
      var track       = document.getElementById('hcr-track-{{ section.id }}');
      var prev        = document.getElementById('hcr-prev-{{ section.id }}');
      var next        = document.getElementById('hcr-next-{{ section.id }}');
      var dotContainer = document.getElementById('hcr-dots-{{ section.id }}');
      if (!track) return;
      var dots  = dotContainer ? dotContainer.querySelectorAll('.hcr-dot') : [];
      var total = {{ section.blocks.size }};
      var current = 0;

      function slideWidth() {
        var slide = track.children[0];
        if (!slide) return 0;
        var gap = parseFloat(getComputedStyle(track).gap) || 0;
        return slide.offsetWidth + gap;
      }

      function goTo(index) {
        index = Math.max(0, Math.min(total - 1, index));
        track.scrollTo({ left: slideWidth() * index, behavior: 'smooth' });
      }

      function update(index) {
        current = index;
        dots.forEach(function(d, i) { d.classList.toggle('is-active', i === index); });
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === total - 1;
      }

      if (prev) prev.addEventListener('click', function() { goTo(current - 1); });
      if (next) next.addEventListener('click', function() { goTo(current + 1); });

      dots.forEach(function(dot, i) {
        dot.addEventListener('click', function() { goTo(i); });
      });

      var ticking = false;
      track.addEventListener('scroll', function() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function() {
          var sw = slideWidth();
          if (sw > 0) update(Math.round(track.scrollLeft / sw));
          ticking = false;
        });
      }, { passive: true });

      update(0);
    })();
  </script>
  {%- endif -%}

</div>


{% schema %}
{
  "name": "Hero Carousel – Rounded",
  "class": "section-hero-carousel-rounded",
  "disabled_on": { "groups": ["aside"] },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 8
    },
    {
      "type": "radio",
      "id": "height",
      "label": "Slide height",
      "options": [
        { "value": "adapt", "label": "Adapt to screen ratio" },
        { "value": "fixed", "label": "Fixed height" }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Desktop fixed height",
      "default": 560
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 100,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile fixed height",
      "default": 440
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Peeking next slide"
    },
    {
      "type": "range",
      "id": "peek_size",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Desktop peek amount",
      "info": "How much of the next slide shows on desktop",
      "default": 48
    },
    {
      "type": "range",
      "id": "peek_size_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Mobile peek amount",
      "default": 24
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "id": "overlay_style",
      "type": "select",
      "label": "Overlay style",
      "default": "shadow",
      "options": [
        { "value": "full", "label": "Tint" },
        { "value": "box", "label": "Box" },
        { "value": "shadow", "label": "Text shadow" },
        { "value": "full image-overlay--bg-shadow", "label": "Text shadow and tint" },
        { "value": "no_background", "label": "No background" }
      ]
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Slideshow description",
      "info": "Describe the slideshow for screen readers."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "2048 x 1024px recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "1024 x 1024px recommended"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide link",
          "info": "Used when no buttons are set"
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "info": "Enter <br> for a line-break",
          "default": "Slide heading"
        },
        {
          "type": "range",
          "id": "heading_max_width",
          "min": 4,
          "max": 40,
          "step": 1,
          "unit": "em",
          "label": "Maximum heading width",
          "default": 15
        },
        {
          "type": "range",
          "id": "title_size",
          "min": 20,
          "max": 150,
          "step": 2,
          "unit": "px",
          "label": "Desktop heading size",
          "default": 72
        },
        {
          "type": "range",
          "id": "title_size_mobile",
          "min": 20,
          "max": 120,
          "step": 2,
          "unit": "px",
          "label": "Mobile heading size",
          "default": 40
        },
        {
          "type": "checkbox",
          "id": "use_h1",
          "label": "Set as primary page heading",
          "default": false
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text"
        },
        {
          "type": "checkbox",
          "id": "enlarge_text",
          "label": "Enlarge body text",
          "default": false
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Button 1 label"
        },
        {
          "type": "url",
          "id": "button_url_1",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_tag_1",
          "label": "Button 1 filter by tag"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button_url_2",
          "label": "Button 2 link"
        },
        {
          "type": "text",
          "id": "button_tag_2",
          "label": "Button 2 filter by tag"
        },
        {
          "type": "header",
          "content": "Text placement"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text position",
          "options": [
            { "value": "top left",      "label": "Top left" },
            { "value": "top center",    "label": "Top center" },
            { "value": "top right",     "label": "Top right" },
            { "value": "center left",   "label": "Middle left" },
            { "value": "center center", "label": "Middle center" },
            { "value": "center right",  "label": "Middle right" },
            { "value": "bottom left",   "label": "Bottom left" },
            { "value": "bottom center", "label": "Bottom center" },
            { "value": "bottom right",  "label": "Bottom right" }
          ],
          "default": "center center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel – Rounded",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}