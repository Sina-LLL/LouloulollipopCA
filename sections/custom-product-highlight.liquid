<link rel="stylesheet" href="{{ 'custom-product-highlight.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>

<div id="section-id-{{ section.id }}" class="{% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }} fully-padded-row--medium{% else %}fully-spaced-row--medium{% endif %}">
  {% style %}
    #section-id-{{ section.id }} .custom-product-highlight__media.height--fixed {
      --image-height: {{ section.settings.image_height_mobile | default: 460 }}px;
    }
  {% endstyle %}
  <div class="custom-product-highlight__container container container--no-max">
    <div class="custom-product-highlight__layout{% if section.settings.order %} custom-product-highlight__layout--reverse{% endif %}">

      <div class="custom-product-highlight__media height--fixed image-overlay image-overlay--bg-shadow fade-in-up" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
        {%- if section.settings.link != blank -%}<a class="image-overlay__image-link" href="{{ section.settings.link }}">{%- endif -%}
        <div class="height__image image-overlay__image">
          {%- if section.settings.image != blank -%}
            {%- render 'image' with section.settings.image, sizes: '(min-width: 900px) 46vw, 100vw', widths: '640, 960, 1280, 1600' -%}
          {%- else -%}
            <div class="placeholder-image dark">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.link != blank -%}</a>{%- endif -%}

        <div class="text-overlay text-overlay--for-banner text-overlay--v-bottom text-overlay--h-left image-overlay__over">
          <div class="text-overlay__inner">
            <div class="text-overlay__text">
              {%- if section.settings.title != blank -%}
                <h2 class="text-overlay__title h1">{{ section.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.text != blank -%}
                <div class="text-overlay__rte rte">{{ section.settings.text }}</div>
              {%- endif -%}
              {%- if section.settings.button_label != blank -%}
                <div class="text-overlay__button-row button-row">
                  <a class="text-overlay__button button-row__btn {% if section.settings.button_style != 'link' %}btn btn--{{ section.settings.button_style }}{% else %}small-feature-link{% endif %}" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }}</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      <div class="custom-product-highlight__products fade-in-up" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
        <carousel-slider class="carousel block" style="width: 100%;">
          <div class="collection-listing slider">
            <div class="product-grid product-grid--per-row-3 product-grid--per-row-mob-2 slider__grid product-grid--carousel">
              {%- if section.settings.product_list == blank -%}
                {%- for i in (1..6) -%}
                  {%- render 'onboarding-product-block', forloop: forloop -%}
                {%- endfor -%}
              {%- else -%}
                {%- for product in section.settings.product_list limit: 6 -%}
                  <div class="slider__item">
                    {%- render 'product-block', product: product, custom_aspect_ratio: 1, no_swiping: true, no_quick_buy_markup: true -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        </carousel-slider>
      </div>

    </div>
  </div>
</div>


{% schema %}
{
  "name": "Highlighted Collection",
  "class": "section-featured-collection",
  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Product list"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subtitle text",
      "info": "Keep it short — this sits over the photo, like a one-line subtitle.",
      "default": "<p>Share a short line about this collection.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height (mobile)",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "checkbox",
      "id": "order",
      "label": "Put image on the right",
      "default": false
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Product list",
      "limit": 6
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        {
          "label": "Primary",
          "value": "primary"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        },
        {
          "label": "Link",
          "value": "link"
        }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlighted Collection",
      "settings": {
        "title": "Highlighted Collection"
      }
    }
  ]
}
{% endschema %}
