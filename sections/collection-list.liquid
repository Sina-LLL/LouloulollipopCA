<div class="section-id-{{ section.id }} collection-slider-row for-collections {% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }}{% endif %}">
  <div class="container{% if section.settings.full_width %} container--no-max{% endif %}">
    
    <!-- Header Section -->
    <div class="carousel-header">
      <div class="carousel-header__content">
        <h2 class="h4 text-{{ section.settings.text_alignment}}">
          <a class="has-paging__title" href="{{ collection.url }}">{{ section.settings.title | escape }}</a>
        </h2>
        {% if section.settings.text != blank %}
          <div class="rte text-{{ section.settings.text_alignment}}">{{ section.settings.text }}</div>
        {% endif %}
      </div>
      
      {%- if section.settings.enable_carousel -%}
        <!-- Desktop Navigation in Header -->
        <div class="carousel-header__nav desktop-only">
          <button type="button" class="carousel-nav-btn carousel-nav-btn--prev" aria-label="Previous">
            {%- render 'icon-chevron-left', stroke_width: 1.5 -%}
          </button>
          <button type="button" class="carousel-nav-btn carousel-nav-btn--next" aria-label="Next">
            {%- render 'icon-chevron-right', stroke_width: 1.5 -%}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.enable_carousel -%}
      <div class="modern-carousel" data-grid-desktop="{{ section.settings.grid }}" data-grid-mobile="{{ section.settings.coll_thumb_mob_per_row }}" data-total-items="{{ section.blocks.size }}">
    {%- endif -%}

    <!-- Collection Grid -->
    <div class="collection-wrapper{% if section.settings.enable_carousel %} is-carousel{% endif %}">
      <div class="collection-grid" data-grid="{{ section.settings.grid }}" data-grid-mobile="{{ section.settings.coll_thumb_mob_per_row }}">
        {%- liquid
          if section.blocks.size > 0
            if section.settings.coll_grid_image_shape == 'portrait-23'
              assign chosen_aspect_ratio = 0.67
            elsif section.settings.coll_grid_image_shape == 'portrait-45'
              assign chosen_aspect_ratio = 0.8
            elsif section.settings.coll_grid_image_shape == 'square'
              assign chosen_aspect_ratio = 1.0
            elsif section.settings.coll_grid_image_shape == 'landscape-54'
              assign chosen_aspect_ratio = 1.25
            elsif section.settings.coll_grid_image_shape == 'landscape-32'
              assign chosen_aspect_ratio = 1.50
            elsif section.settings.coll_grid_image_shape == 'tallest'
              assign chosen_aspect_ratio = 999
              for block in section.blocks
                assign collection = collections[block.settings.collection]
                if collection != blank
                  assign collection_image = block.settings.image | default: collection.featured_image
                  if collection_image.aspect_ratio < chosen_aspect_ratio
                    assign chosen_aspect_ratio = collection_image.aspect_ratio
                  endif
                endif
              endfor
            else
              assign chosen_aspect_ratio = 0
              for block in section.blocks
                assign collection = collections[block.settings.collection]
                if collection != blank
                  assign collection_image = block.settings.image | default: collection.featured_image
                  if collection_image.aspect_ratio > chosen_aspect_ratio
                    assign chosen_aspect_ratio = collection_image.aspect_ratio
                  endif
                endif
              endfor
            endif

            for block in section.blocks
              assign collection = collections[block.settings.collection]

              if section.settings.enable_carousel
                echo '<div class="collection-item">'
              endif

              unless collection == blank
                render 'collection-block', collection: collection, subheading: block.settings.subheading, button_label: block.settings.button_label, custom_attrs: block.shopify_attributes, custom_image: block.settings.image, custom_aspect_ratio: chosen_aspect_ratio, settings_object: section.settings, tag: block.settings.tag
              else
                render 'onboarding-collection-block', forloop: forloop, settings_object: section.settings
              endunless

              if section.settings.enable_carousel
                echo '</div>'
              endif
            endfor

          else
            for i in (1..6)
              if section.settings.enable_carousel
                echo '<div class="collection-item">'
              endif
              render 'onboarding-collection-block', forloop: forloop, settings_object: section.settings
              if section.settings.enable_carousel
                echo '</div>'
              endif
            endfor
          endif
        -%}
      </div>
    </div>

    {%- if section.settings.enable_carousel -%}
        <!-- Progress Indicators -->
        <div class="carousel-progress">
          <div class="carousel-dots"></div>
          <div class="carousel-counter">
            <span class="carousel-counter__current">1</span>
            <span class="carousel-counter__separator">/</span>
            <span class="carousel-counter__total">1</span>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
/* Modern Carousel Styles */
.collection-slider-row {
  padding: 60px 0;
}

/* Header with Navigation */
.carousel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  gap: 24px;
}

.carousel-header__content {
  flex: 1;
}

.carousel-header h2 {
  margin: 0 0 8px 0;
}

.carousel-header .rte {
  margin: 0;
  color: rgba(0, 0, 0, 0.6);
}

.carousel-header__nav {
  display: flex;
  gap: 8px;
}

.desktop-only {
  display: flex;
}

/* Navigation Buttons */
.carousel-nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.1);
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.carousel-nav-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.05);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.carousel-nav-btn:hover::before {
  opacity: 1;
}

.carousel-nav-btn:hover {
  border-color: rgba(0, 0, 0, 0.2);
  transform: translateY(-1px);
}

.carousel-nav-btn:active {
  transform: translateY(0);
}

.carousel-nav-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
  transform: none;
}

.carousel-nav-btn:disabled:hover::before {
  opacity: 0;
}

.carousel-nav-btn svg {
  width: 18px;
  height: 18px;
  position: relative;
  z-index: 1;
}

/* Carousel Container */
.modern-carousel {
  position: relative;
}

.collection-wrapper {
  position: relative;
}

.collection-wrapper.is-carousel {
  overflow: hidden;
  margin: 0 -16px;
  padding: 0 16px;
}

.collection-grid {
  display: grid;
  gap: 20px;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}

.collection-grid[data-grid="2"] {
  grid-template-columns: repeat(2, 1fr);
}

.collection-grid[data-grid="3"] {
  grid-template-columns: repeat(3, 1fr);
}

.collection-grid[data-grid="4"] {
  grid-template-columns: repeat(4, 1fr);
}

.collection-grid[data-grid="5"] {
  grid-template-columns: repeat(5, 1fr);
}

/* Carousel Mode */
.is-carousel .collection-grid {
  display: flex;
  gap: 20px;
}

.is-carousel .collection-item {
  flex: 0 0 auto;
  scroll-snap-align: start;
}

/* Progress Section */
.carousel-progress {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-top: 32px;
}

/* Dots */
.carousel-dots {
  display: flex;
  gap: 6px;
  align-items: center;
}

.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.15);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.carousel-dot:hover {
  background: rgba(0, 0, 0, 0.3);
  transform: scale(1.2);
}

.carousel-dot.is-active {
  width: 28px;
  background: rgba(0, 0, 0, 0.8);
}

/* Counter */
.carousel-counter {
  display: flex;
  align-items: baseline;
  gap: 4px;
  font-size: 14px;
  color: rgba(0, 0, 0, 0.5);
  font-weight: 500;
  min-width: 60px;
  justify-content: center;
}

.carousel-counter__current {
  font-size: 18px;
  color: rgba(0, 0, 0, 0.9);
  font-weight: 600;
}

.carousel-counter__separator {
  margin: 0 2px;
}

/* Mobile Styles */
@media (max-width: 768px) {
  .collection-slider-row {
    padding: 40px 0;
  }

  .carousel-header {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .carousel-header__content {
    width: 100%;
  }

  .desktop-only {
    display: none;
  }

  .carousel-nav-btn {
    width: 40px;
    height: 40px;
  }

  .carousel-nav-btn svg {
    width: 16px;
    height: 16px;
  }

  .collection-grid[data-grid-mobile="1"] .collection-item {
    width: calc(100% - 40px);
  }

  .collection-grid[data-grid-mobile="2"] .collection-item {
    width: calc(50% - 30px);
  }

  .carousel-progress {
    margin-top: 24px;
    gap: 16px;
  }

  .carousel-dot {
    width: 6px;
    height: 6px;
  }

  .carousel-dot.is-active {
    width: 20px;
  }

  .carousel-counter {
    font-size: 13px;
  }

  .carousel-counter__current {
    font-size: 16px;
  }
}

/* Desktop Grid Sizes */
@media (min-width: 769px) {
  .collection-grid[data-grid="2"] .collection-item {
    width: calc(50% - 10px);
  }

  .collection-grid[data-grid="3"] .collection-item {
    width: calc(33.333% - 14px);
  }

  .collection-grid[data-grid="4"] .collection-item {
    width: calc(25% - 15px);
  }

  .collection-grid[data-grid="5"] .collection-item {
    width: calc(20% - 16px);
  }
}

/* Smooth Transitions */
.collection-grid {
  -webkit-overflow-scrolling: touch;
}

/* Hide scrollbar on carousel */
.is-carousel::-webkit-scrollbar {
  display: none;
}

.is-carousel {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const carousels = document.querySelectorAll('.modern-carousel');
  
  carousels.forEach(carousel => {
    const wrapper = carousel.querySelector('.collection-wrapper');
    const grid = carousel.querySelector('.collection-grid');
    const items = carousel.querySelectorAll('.collection-item');
    const prevBtn = carousel.closest('.container').querySelector('.carousel-nav-btn--prev');
    const nextBtn = carousel.closest('.container').querySelector('.carousel-nav-btn--next');
    const dotsContainer = carousel.querySelector('.carousel-dots');
    const counterCurrent = carousel.querySelector('.carousel-counter__current');
    const counterTotal = carousel.querySelector('.carousel-counter__total');
    
    if (!grid || items.length === 0) return;
    
    const totalItems = parseInt(carousel.dataset.totalItems) || items.length;
    const gridDesktop = parseInt(carousel.dataset.gridDesktop) || 4;
    const gridMobile = parseInt(carousel.dataset.gridMobile) || 2;
    
    let currentPage = 0;
    let totalPages = 1;
    let itemsPerPage = gridDesktop;
    let isDragging = false;
    let startX = 0;
    let currentTranslate = 0;
    let prevTranslate = 0;
    let animationID;
    
    // Get items per page based on viewport
    function getItemsPerPage() {
      return window.innerWidth < 769 ? gridMobile : gridDesktop;
    }
    
    // Calculate total pages
    function calculatePages() {
      itemsPerPage = getItemsPerPage();
      totalPages = Math.ceil(totalItems / itemsPerPage);
      return totalPages;
    }
    
    // Generate dots
    function generateDots() {
      calculatePages();
      dotsContainer.innerHTML = '';
      
      for (let i = 0; i < totalPages; i++) {
        const dot = document.createElement('button');
        dot.className = `carousel-dot${i === 0 ? ' is-active' : ''}`;
        dot.setAttribute('aria-label', `Go to page ${i + 1}`);
        dot.addEventListener('click', () => goToPage(i));
        dotsContainer.appendChild(dot);
      }
      
      updateCounter();
    }
    
    // Update counter
    function updateCounter() {
      counterCurrent.textContent = currentPage + 1;
      counterTotal.textContent = totalPages;
    }
    
    // Update dots
    function updateDots() {
      const dots = dotsContainer.querySelectorAll('.carousel-dot');
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentPage);
      });
    }
    
    // Update buttons
    function updateButtons() {
      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
    }
    
    // Get transform value
    function getTranslateX() {
      const itemWidth = items[0].offsetWidth;
      const gap = 20; // matches CSS gap
      const pageWidth = itemsPerPage * (itemWidth + gap);
      return -(currentPage * pageWidth);
    }
    
    // Animate to page
    function goToPage(pageIndex, smooth = true) {
      currentPage = Math.max(0, Math.min(pageIndex, totalPages - 1));
      const translateX = getTranslateX();
      
      if (smooth) {
        grid.style.transition = 'transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
      } else {
        grid.style.transition = 'none';
      }
      
      grid.style.transform = `translateX(${translateX}px)`;
      currentTranslate = translateX;
      prevTranslate = translateX;
      
      updateDots();
      updateButtons();
      updateCounter();
    }
    
    // Navigation
    function goToNextPage() {
      if (currentPage < totalPages - 1) {
        goToPage(currentPage + 1);
      }
    }
    
    function goToPrevPage() {
      if (currentPage > 0) {
        goToPage(currentPage - 1);
      }
    }
    
    // Touch/Mouse drag events
    function touchStart(e) {
      isDragging = true;
      startX = e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
      animationID = requestAnimationFrame(animation);
      grid.style.cursor = 'grabbing';
    }
    
    function touchMove(e) {
      if (!isDragging) return;
      const currentX = e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
      const diff = currentX - startX;
      currentTranslate = prevTranslate + diff;
    }
    
    function touchEnd() {
      isDragging = false;
      cancelAnimationFrame(animationID);
      grid.style.cursor = 'grab';
      
      const movedBy = currentTranslate - prevTranslate;
      const itemWidth = items[0].offsetWidth;
      
      // If moved enough, go to next/prev page
      if (movedBy < -itemWidth / 4 && currentPage < totalPages - 1) {
        goToPage(currentPage + 1);
      } else if (movedBy > itemWidth / 4 && currentPage > 0) {
        goToPage(currentPage - 1);
      } else {
        goToPage(currentPage);
      }
    }
    
    function animation() {
      if (isDragging) {
        grid.style.transition = 'none';
        grid.style.transform = `translateX(${currentTranslate}px)`;
        requestAnimationFrame(animation);
      }
    }
    
    // Event listeners
    if (prevBtn) prevBtn.addEventListener('click', goToPrevPage);
    if (nextBtn) nextBtn.addEventListener('click', goToNextPage);
    
    // Touch events
    grid.addEventListener('mousedown', touchStart);
    grid.addEventListener('touchstart', touchStart, { passive: true });
    grid.addEventListener('mousemove', touchMove);
    grid.addEventListener('touchmove', touchMove, { passive: true });
    grid.addEventListener('mouseup', touchEnd);
    grid.addEventListener('mouseleave', touchEnd);
    grid.addEventListener('touchend', touchEnd);
    
    // Prevent text selection while dragging
    grid.addEventListener('dragstart', (e) => e.preventDefault());
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goToPrevPage();
      if (e.key === 'ArrowRight') goToNextPage();
    });
    
    // Initialize
    grid.style.cursor = 'grab';
    generateDots();
    updateButtons();
    goToPage(0, false);
    
    // Handle resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        const oldItemsPerPage = itemsPerPage;
        generateDots();
        
        if (oldItemsPerPage !== itemsPerPage) {
          currentPage = 0;
          goToPage(0, false);
        } else {
          goToPage(currentPage, false);
        }
      }, 250);
    });
  });
});
</script>

