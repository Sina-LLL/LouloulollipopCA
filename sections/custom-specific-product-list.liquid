<div id="section-id-{{ section.id }}" class="{% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }} fully-padded-row--medium{% else %}fully-spaced-row--medium{% endif %}">
  <div class="container">
    <div class="text-center lightly-spaced-row">
      {% if section.settings.heading != blank %}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.body_text != blank %}
        <div class="rte">{{ section.settings.body_text }}</div>
      {% endif %}
    </div>

    <div class="collection-listing fade-in-up" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      <div class="product-grid product-grid--per-row-{{ section.settings.products_per_row }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}">
        {%- liquid
          if section.settings.product_list == blank
            for i in (1..section.settings.products_per_row)
              render 'onboarding-product-block', forloop: forloop
            endfor
          else
            if settings.prod_thumb_shape == 'portrait-23'
              assign chosen_aspect_ratio = 0.67
            elsif settings.prod_thumb_shape == 'portrait-45'
              assign chosen_aspect_ratio = 0.8
            elsif settings.prod_thumb_shape == 'square'
              assign chosen_aspect_ratio = 1.0
            elsif settings.prod_thumb_shape == 'landscape-54'
              assign chosen_aspect_ratio = 1.25
            elsif settings.prod_thumb_shape == 'landscape-32'
              assign chosen_aspect_ratio = 1.50
            elsif settings.prod_thumb_shape == 'tallest'
              assign chosen_aspect_ratio = 99
              for product in section.settings.product_list
                if product.featured_media.preview_image.aspect_ratio < chosen_aspect_ratio
                  assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                endif
              endfor
            else
              assign chosen_aspect_ratio = 0
              for product in section.settings.product_list
                if product.featured_media.preview_image.aspect_ratio > chosen_aspect_ratio
                  assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                endif
              endfor
            endif
            
            for product in section.settings.product_list
              render 'product-block', product: product, custom_aspect_ratio: chosen_aspect_ratio
            endfor
          endif
        -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Product List",
  "class": "section-custom-specific-product-list",
  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Choose your favorite products from our collection.</p>"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "Select products to display"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "info": "Choose 2, 3, or 4 products per row"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Specific Product List"
    }
  ]
}
{% endschema %}