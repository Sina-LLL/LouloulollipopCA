<div class="section-id-{{ section.id }} collection-slider-row for-collections {% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }}{% endif %}">
  <div class="container{% if section.settings.full_width %} container--no-max{% endif %}">
    <div class="hometitle">
      <h2 class=" h4 text-{{ section.settings.text_alignment }}" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.3s"' -%}>
        {{ section.settings.title | escape }}
      </h2>
      {% if section.settings.text != blank %}
        <div class="rte text-{{ section.settings.text_alignment }}" {%- render 'animation-attrs', attrs: animation_attrs -%}>
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    {%- if section.settings.enable_carousel -%}
      <carousel-slider class="carousel block collection-slider">
    {%- endif -%}

    <div class="collection-listing fade-in-up{% if section.settings.enable_carousel %} slider {% if section.settings.full_width %}slider--edge-peek{% endif %} slider--mobile-container-pad {% endif %}" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
      <div class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ section.settings.coll_thumb_mob_per_row }} product-grid--image-shape-{{ section.settings.coll_grid_image_shape }}{% if section.settings.enable_carousel %} slider__grid product-grid--carousel{% endif %}">
        
        {% for block in section.blocks %}
          {% if section.settings.enable_carousel %}
            <div class="slider__item">
          {% endif %}

          <div class="collection-block custom-link-block" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.url | escape }}" class="collection-link">
              {% if block.settings.image %}
                <div class="image-wrapper">
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'responsive-image' }}
                </div>
              {% endif %}
              <div class="text-content text-{{ section.settings.text_alignment }}">
                {% if block.settings.heading != blank %}
                  <h3 class="h4">{{ block.settings.heading }}</h3>
                {% endif %}
                {% if block.settings.subheading != blank %}
                  <p class="subheading">{{ block.settings.subheading }}</p>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <span class="button">{{ block.settings.button_label }}</span>
                {% endif %}
              </div>
            </a>
          </div>

          {% if section.settings.enable_carousel %}
            </div>
          {% endif %}
        {% endfor %}
        
      </div>
    </div>

    {%- if section.settings.enable_carousel -%}
      <div class="slider-nav slider-nav--floating no-js-hidden">
        <button type="button" class="slider-nav__btn has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
          <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
          {%- render 'icon-chevron-left', stroke_width: 1.5 -%}
        </button>
        <button type="button" class="slider-nav__btn has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
          <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
          {%- render 'icon-chevron-right', stroke_width: 1.5 -%}
        </button>
      </div>
      </carousel-slider>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom link list",
  "class": "section-collection-list",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["aside"]
  },
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Custom link list"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Cards per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "id": "full_width",
      "type": "checkbox",
      "label": "Full page width",
      "default": true
    },
    {
      "type": "select",
      "id": "coll_grid_image_shape",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait-45", "label": "Portrait (4:5)" },
        { "value": "landscape-32", "label": "Landscape (3:2)" },
        { "value": "landscape-54", "label": "Landscape (5:4)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "coll_thumb_mob_per_row",
      "label": "Cards per row on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "custom_link",
      "name": "Custom link",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom link list",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
