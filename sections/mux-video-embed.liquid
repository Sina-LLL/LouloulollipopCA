{%- assign mux_urls = product.metafields.custom.mux_video_url.value -%}

{% if product.metafields.custom.mux_video_url %}
    <div class="mux-video-container container container--no-max fully-spaced-row">
      <h2 class="mux-video-title">Expeerly Reviews</h2>
      <div>  
        {%- for urls in mux_urls -%}
          <div class="mux-video-wrapper">
              <video controls preload="none">
                  <source src="{{ urls }}" type="video/mp4">
                  Your browser does not support the video tag.
              </video>         
          </div>
          {% endfor %}
        </div>
    </div>
{% endif %}   


{% schema %}
{
  "name": "Mux Video",
  "tag": "section",
  "class": "page-section-spacing page-section-spacing--no-top-mobile",
  "presets": [
    {
      "name": "Mux Video",
      "category": "Product"
    }
  ]
}
{% endschema %}