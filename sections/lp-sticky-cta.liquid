{%- if section.settings.label != blank and section.settings.link != blank -%}
  <div id="section-id-{{ section.id }}" class="lp-sticky-cta" aria-hidden="true">
    <a href="{{ section.settings.link }}" class="btn">
      {{ section.settings.label }}
    </a>
  </div>
  <style>
    #section-id-{{ section.id }} {
      display: none;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--color-text);
      padding: 12px 16px;
      z-index: 200;
      box-shadow: 0 -4px 16px rgba(0,0,0,0.12);
    }
    #section-id-{{ section.id }} .btn {
      display: block;
      width: 100%;
      text-align: center;
      background: #C9A04A;
      color: #1F2937;
      font-weight: 700;
      border-radius: 4px;
      text-decoration: none;
    }
    @media (max-width: 768px) {
      #section-id-{{ section.id }} { display: block; }
      body { padding-bottom: 72px; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "LP Sticky Mobile CTA",
  "settings": [
    { "type": "text", "id": "label", "label": "Button label", "default": "Shop Sleep Bags →" },
    { "type": "url",  "id": "link",  "label": "Link"          }
  ],
  "presets": [{ "name": "LP Sticky Mobile CTA" }]
}
{% endschema %}