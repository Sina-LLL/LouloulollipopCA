{% comment %}
  Publications Logos Section
  Add this code where you want the logos to appear (after product description)
{% endcomment %}

{% assign publications = product.metafields.custom.pr_mentions.value %}

<!-- DEBUG: Start -->
<div style="border: 2px solid red; padding: 10px; margin: 10px 0;">
  <p>DEBUG INFO:</p>
  <p>Publications exists: {{ publications }}</p>
  <p>Publications size: {{ publications.size }}</p>
  <p>Publications blank: {{ publications == blank }}</p>
</div>
<!-- DEBUG: End -->

{% if publications != blank and publications.size > 0 %}
  <div class="publications-section">
    <h3 class="publications-title">As Featured In</h3>
    
    <div class="publications-grid">
      {% for publication in publications %}
        <!-- DEBUG: Publication {{ forloop.index }} -->
        <div style="border: 1px solid blue; padding: 5px;">
          <p>Logo: {{ publication.logo_image }}</p>
          <p>URL: {{ publication.url_to_publication }}</p>
        </div>
        
        {% if publication.logo_image != blank and publication.url_to_publication != blank %}
          <a href="{{ publication.url_to_publication }}" 
             class="publication-link" 
             target="_blank" 
             rel="noopener noreferrer"
             title="{{ publication.title | default: 'Publication' }}">
            <img 
              src="{{ publication.logo_image | image_url: width: 200 }}" 
              alt="{{ publication.title | default: 'Publication logo' }}"
              loading="lazy"
              class="publication-logo">
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    .publications-section {
      margin: 2rem 0;
      padding: 2rem 0;
      border-top: 1px solid #e5e5e5;
    }
    
    .publications-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      text-align: center;
      color: #333;
    }
    
    .publications-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      align-items: center;
      justify-content: center;
    }
    
    .publication-link {
      display: block;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    
    .publication-link:hover {
      opacity: 0.7;
      transform: translateY(-2px);
    }
    
    .publication-logo {
      max-width: 120px;
      max-height: 60px;
      width: auto;
      height: auto;
      object-fit: contain;
      filter: grayscale(100%);
      transition: filter 0.2s ease;
    }
    
    .publication-link:hover .publication-logo {
      filter: grayscale(0%);
    }
    
    @media screen and (max-width: 768px) {
      .publications-grid {
        gap: 1.5rem;
      }
      
      .publication-logo {
        max-width: 100px;
        max-height: 50px;
      }
    }
  </style>
{% else %}
  <div style="border: 2px solid orange; padding: 10px; margin: 10px 0;">
    <p>Publications section not showing because publications is empty or blank</p>
  </div>
{% endif %}