{%- comment -%}
  Standalone Product JSON-LD entity. Emits its own <script> tag (not
  nested inside a @graph array) so it can be safely rendered from two
  different contexts:
    - snippets/structured-data.liquid, on the real PDP (request.page_type
      == 'product'), where its "@id" is cross-referenced by that file's
      WebPage.mainEntity in a separate <script> block (valid per JSON-LD:
      consumers merge @id references across script tags on the same page).
    - sections/featured-product.liquid, which can embed a single product
      on non-product templates (e.g. a collection page) via its own
      section-scoped `product` setting.

  Parameters:
  - product {Object} - Product object.
  - current_variant {Object} - Current/selected variant object.
{%- endcomment -%}

{%- liquid
  if product.metafields.custom.material != blank
    assign material_raw = product.metafields.custom.material.value
    if material_raw.first != blank
      assign material_value = material_raw | join: ', '
    else
      assign material_value = material_raw | remove: '["' | remove: '"]' | remove: '[' | remove: ']'
    endif
  elsif product.tags contains 'TENCEL'
    assign material_value = 'TENCEL Lyocell'
  elsif product.tags contains 'muslin'
    assign material_value = '100% Organic Muslin Cotton'
  elsif product.tags contains 'silicone'
    assign material_value = '100% Food-Grade Silicone'
  elsif product.tags contains 'waffle'
    assign material_value = 'TENCEL Lyocell Waffle Knit'
  else
    assign material_value = product.type
  endif

  assign jm_rating_obj = product.metafields.reviews.rating.value
  assign jm_review_count = product.metafields.reviews.rating_count | plus: 0
  assign show_rating = false
  if jm_rating_obj != blank and jm_review_count > 0
    assign show_rating = true
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 1000 | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [
    {%- for image in product.images limit: 5 -%}
    "{{ image | image_url: width: 1200 | prepend: 'https:' }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- if current_variant.sku != blank -%}
  "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {% if product.vendor != blank %}{{ product.vendor | json }}{% else %}{{ shop.name | json }}{% endif %}
  },
  "material": {{ material_value | json }}
  {%- if product.collections.first -%},
  "category": {{ product.collections.first.title | json }}
  {%- endif -%},
  "offers": {
    "@type": "AggregateOffer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ shop.currency }}",
    "offerCount": {{ product.variants.size }},
    "lowPrice": {{ product.price_min | times: 0.01 | round: 2 }},
    "highPrice": {{ product.price_max | times: 0.01 | round: 2 }},
    "offers": [
      {%- for v in product.variants -%}
      {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}?variant={{ v.id }}",
        "priceCurrency": "{{ shop.currency }}",
        "price": {{ v.price | times: 0.01 | round: 2 }},
        "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}"
        {%- if v.sku != blank -%},"sku": {{ v.sku | json }}{%- endif -%}
        {%- assign bc = v.barcode | strip -%}
        {%- if bc != blank -%}
          {%- assign bc_len = bc | size -%}
          {%- if bc_len == 14 -%},"gtin14": {{ bc | json }}{%- endif -%}
          {%- if bc_len == 13 -%},"gtin13": {{ bc | json }}{%- endif -%}
          {%- if bc_len == 12 -%},"gtin12": {{ bc | json }}{%- endif -%}
          {%- if bc_len == 8 -%},"gtin8": {{ bc | json }}{%- endif -%}
        {%- endif -%},
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "@id": "{{ shop.url }}#organization",
          "name": {{ shop.name | json }}
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  {%- if show_rating -%},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ jm_rating_obj.rating | json }},
    "reviewCount": {{ jm_review_count | json }},
    "bestRating": {{ jm_rating_obj.scale_max | default: 5 | json }},
    "worstRating": {{ jm_rating_obj.scale_min | default: 1 | json }}
  }
  {%- endif -%}
  {%- if product.metafields.reviews.recent_json != blank -%},
  "review": {{ product.metafields.reviews.recent_json }}
  {%- endif -%}
}
</script>
